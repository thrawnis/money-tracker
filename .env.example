# Copy this file to .env and fill in values before running rebuild.sh

DB_PASSWORD=change_me_to_a_strong_password

# Generate with: openssl rand -base64 32
JWT_KEY=change_me_to_a_random_256bit_secret

# Generate with: openssl rand -base64 32  (must be different from JWT_KEY)
ENCRYPTION_KEY=change_me_to_a_different_random_256bit_secret

# Passkeys (the default second factor at sign-in) are tied to the address you
# open Money Tracker at, and browsers only allow them over HTTPS (or on
# localhost). Set FIDO2_DOMAIN to that host name (e.g. money.yourdomain.com,
# your Cloudflare Tunnel domain) and FIDO2_ORIGIN to the full address you type
# in the browser (e.g. https://money.yourdomain.com). Several origins can be
# comma-separated. Changing the domain later means re-adding passkeys.
FIDO2_DOMAIN=localhost
FIDO2_ORIGIN=https://localhost:3000

# -- Daily email digest (optional) ---------------------------------------------
# Lets users turn on a daily summary email in Settings → Preferences. Leave
# SMTP_HOST empty to disable email. Examples:
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com
#             SMTP_PASSWORD=<an App Password, not your normal password>
#   Fastmail: SMTP_HOST=smtp.fastmail.com SMTP_PORT=465 SMTP_SECURITY=ssl
# SMTP_SECURITY: starttls (default, usually port 587) | ssl (port 465) | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Money Tracker <you@example.com>
SMTP_SECURITY=starttls
# Set to true to accept a self-signed (or otherwise unverifiable) certificate
# from the mail server, e.g. a home server. Leave false for public providers:
# with it on, someone on the network path could pose as the mail server and
# capture the SMTP password.
SMTP_ALLOW_INVALID_CERT=false
# When email is set up (SMTP_HOST and SMTP_FROM), every account (except the
# demo account) must verify its email address with an emailed code before it
# can sign in — new accounts and existing ones alike. If email stops working
# and you can't sign in, set this to false and rebuild.
REQUIRE_EMAIL_VERIFICATION=true
# Address for links in emails; defaults to the first FIDO2_ORIGIN
APP_URL=

# -- AI -----------------------------------------------------------------------
# One AI server for the AI assistant ("Ask AI" page) and receipt scanning.
# Users turn the assistant on, and choose what it may look up, in Settings →
# AI Assistant. Questions and the data needed to answer them go to this server.
#
#   AI_PROVIDER  ollama | openai | anthropic | gemini   (blank = no AI)
#   AI_BASE_URL  optional. ollama: blank = the bundled Ollama container, or your
#                Ollama server e.g. http://192.168.1.20:11434. openai: blank =
#                OpenAI, or any OpenAI-compatible server (LM Studio, vLLM…) e.g.
#                http://192.168.1.20:1234/v1
#   AI_API_KEY   for openai / anthropic / gemini
#   AI_MODEL     optional for openai (gpt-4o-mini), anthropic (claude-haiku-4-5-20251001)
#                and gemini (gemini-2.0-flash); required for ollama. The assistant
#                needs a model with tool calling (e.g. qwen2.5:14b, not llava).
#
# Examples:
#   AI_PROVIDER=openai     AI_API_KEY=sk-...
#   AI_PROVIDER=ollama     AI_MODEL=qwen2.5:14b
#   AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Receipt scanning uses the AI settings above. To use something else for
# receipts — e.g. a vision model such as llava or llama3.2-vision — set these
# (same meanings as above; blank RECEIPT_PROVIDER = use the AI settings). With
# no AI settings at all, receipts use the bundled Ollama container with llava.
RECEIPT_PROVIDER=
RECEIPT_BASE_URL=
RECEIPT_API_KEY=
RECEIPT_MODEL=
