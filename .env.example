# Copy this file to .env and fill in values before running rebuild.sh

DB_PASSWORD=change_me_to_a_strong_password

# Generate with: openssl rand -base64 32
JWT_KEY=change_me_to_a_random_256bit_secret

# Generate with: openssl rand -base64 32  (must be different from JWT_KEY)
ENCRYPTION_KEY=change_me_to_a_different_random_256bit_secret

# Passkeys (the default second factor at sign-in) are tied to the address you
# open Money Tracker at, and browsers only allow them over HTTPS (or on
# localhost). Set FIDO2_DOMAIN to that host name (e.g. money.yourdomain.com,
# your Cloudflare Tunnel domain) and FIDO2_ORIGIN to the full address you type
# in the browser (e.g. https://money.yourdomain.com). Several origins can be
# comma-separated. Changing the domain later means re-adding passkeys.
FIDO2_DOMAIN=localhost
FIDO2_ORIGIN=https://localhost:3000

# -- Receipt Scanning ---------------------------------------------------------
#
# Provider: ollama (default) | anthropic | openai | gemini
RECEIPT_PROVIDER=ollama

# --- Ollama (default provider) -----------------------------------------------
# Leave OLLAMA_EXTERNAL_URL blank to spin up a local Ollama container.
# Set it to use an external Ollama server (local container will not start).
OLLAMA_EXTERNAL_URL=
# Vision-capable model to use (must be pulled on the Ollama server)
# Common options: llava, llava:13b, llama3.2-vision, bakllava
OLLAMA_MODEL=llava

# --- Anthropic / Claude (set RECEIPT_PROVIDER=anthropic) ---------------------
ANTHROPIC_API_KEY=
# Model override (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI / ChatGPT (set RECEIPT_PROVIDER=openai) -------------------------
OPENAI_API_KEY=
# Model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Base URL override — use this for any OpenAI-compatible API (e.g. Azure, local LLM)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini (set RECEIPT_PROVIDER=gemini) -----------------------------
GEMINI_API_KEY=
# Model override (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
